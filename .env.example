# Copy to .env for local development (pnpm dotenv-loads it, or export
# these yourself before running `pnpm --filter @workspace/api-server run dev`).

# Required
DATABASE_URL=postgres://user:password@localhost:5432/slidesync
PORT=8080

# Optional — presenter/admin password (defaults to "zoe123" if unset).
# On a public deploy, set this to something private.
PRESENTER_PASSWORD=zoe123

# Optional — where uploaded slide files are stored on disk.
# Defaults to ./.data/objects relative to the process's working directory.
OBJECT_STORAGE_DIR=./.data/objects

# Optional — only needed for the AI quiz-generation feature.
# Point BASE_URL at any OpenAI-compatible endpoint.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
